table(Idents(merged))


all_markers <- FindAllMarkers(merged, only.pos = TRUE)
all_markers %>%
  group_by(cluster) %>%
  dplyr::filter(avg_log2FC > 1)


all_markers %>%
  group_by(cluster) %>%
  dplyr::filter(avg_log2FC > 1) %>%
  slice_head(n = 10) %>%
  ungroup() -> top10
DoHeatmap(merged, features = top10$gene) + NoLegend()





