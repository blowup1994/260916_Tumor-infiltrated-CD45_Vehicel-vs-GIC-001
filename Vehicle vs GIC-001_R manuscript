d1 <- Read10X_h5("C:/Users/안재희/Desktop/RNAseq/260916_Tumor-infiltrated CD45_Vehicel vs GIC-001/HN00286557_result_10X/Ctrl/filtered_feature_bc_matrix.h5")
d2 <- Read10X_h5("C:/Users/안재희/Desktop/RNAseq/260916_Tumor-infiltrated CD45_Vehicel vs GIC-001/HN00286557_result_10X/GIC-001/filtered_feature_bc_matrix.h5")

seu1 <- CreateSeuratObject(
  counts = d1,
  project = "Vehicle",
  min.cells = 3,
  min.features = 200
)

seu2 <- CreateSeuratObject(
  counts = d2,
  project = "GIC-001",
  min.cells = 3,
  min.features = 200
)

seu1$condition <- "Vehicle"
seu2$condition <- "GIC-001"

merged <- merge(seu1, seu2, add.cell.ids = c("Vehicle", "GIC-001"))
merged[["percent.mt"]] <- PercentageFeatureSet(merged, pattern = "^MT-")
merged <- subset(merged, subset = nFeature_RNA > 10 & nFeature_RNA < 6000 & percent.mt <5)
VlnPlot(merged, features = "nFeature_RNA")

merged <- NormalizeData(merged, normalization.method = "LogNormalize", scale.factor = 10000)
merged <- FindVariableFeatures(merged, selection.method = "vst", nfeatures = 4000)

merged <- ScaleData(merged, do.center = FALSE)
merged <- RunPCA(merged)
merged <- FindNeighbors(object = merged, dims = 1:10)
merged <- FindClusters(object = merged,
                       algorithm = 4)

merged <- RunUMAP(merged, dims = 1:10)
Idents(merged)

merged$condition <- factor(
  merged$condition,
  levels = c("Vehicle", "GIC-001")
)

merged$seurat_clusters <- as.numeric(as.character(merged$seurat_clusters)) - 1
merged$seurat_clusters <- factor(merged$seurat_clusters)
Idents(merged) <- "seurat_clusters"
table(merged$condition)
VlnPlot(merged, features = "nFeature_RNA",
        group.by = "condition")  +
  labs(
    x = NULL,
    y = "Number of detected genes",
    title = NULL
  ) +
  theme(
    axis.text.x = element_text(angle = 0, hjust = 0.5)
  )


p <- DimPlot(merged,
             pt.size = 0.5)


p <- DimPlot(merged, split.by = "condition",
             pt.size = 1.1)

p + labs(
  x = "UMAP1",
  y = "UMAP2"
)



p_all <- DimPlot(
  merged,
