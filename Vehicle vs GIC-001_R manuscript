####### Cluster proportion #######

df_bar <- merged@meta.data %>%
  count(condition, seurat_clusters) %>%
  group_by(condition) %>%
  mutate(prop = n / sum(n)) %>%
  ungroup()

ggplot(df_bar, aes(x = condition, y = prop, fill = factor(seurat_clusters))) +
  geom_bar(
    stat = "identity",
    width = 0.75,
    color = "black",
    linewidth = 0.2
  ) +
  theme_classic() +
  scale_y_continuous(
    labels = scales::percent_format(accuracy = 1)
  ) +
  labs(
    title = "Distribution of Clusters by Condition",
    x = NULL,
    y = "Proportion of Cells (%)",
    fill = "Cluster"
  ) +
  theme(
    text = element_text(size = 16),
    axis.text = element_text(size = 14),
    axis.title = element_text(size = 16),
    plot.title = element_text(size = 18),
    legend.title = element_text(size = 14),
    legend.text = element_text(size = 13)
  )



